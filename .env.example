# ---- Dashboard ----
# Porta sulla macchina host per la dashboard (dentro il container resta 8000).
DASHBOARD_PORT=8010

# Chiave per firmare i cookie di sessione. OBBLIGATORIA in produzione.
# Generane una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# development | production  (in production SECRET_KEY è obbligatoria e i cookie sono Secure)
APP_ENV=development

# Cookie solo su HTTPS (attivalo quando pubblichi la dashboard online)
COOKIE_SECURE=false

# Durata sessione in secondi (default 12 ore)
SESSION_MAX_AGE=43200

# Dove finiscono database, upload ed export
DATA_DIR=./data

# ---- Scraper ----
# Chiave API di Google Places (New) — https://console.cloud.google.com/apis/credentials
# Serve solo se usi la sorgente "google"; con "osm" (OpenStreetMap) non serve nulla.
GOOGLE_PLACES_API_KEY=

# Endpoint Overpass (OpenStreetMap), separati da virgola. Lascia il default:
# se l'istanza principale è sovraccarica (errori 406/429) lo scraper ritenta e
# poi passa automaticamente ai mirror.
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# ---- MCP (accesso in sola lettura per Claude) ----
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vuota di default: l'endpoint /mcp resta chiuso (401) finché non la imposti.
# Nessuno strumento MCP scrive dati: legge solo routine/segmenti/metriche.
MCP_API_KEY=
